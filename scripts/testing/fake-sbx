#!/usr/bin/env bash
# Minimal stand-in for `sbx` to smoke-test scripts/e2e-claude.sh mechanics without a real sbx host:
#
#   FAKE_SBX_STATE=$(mktemp -d) SBX=scripts/testing/fake-sbx SANDBOX_DAEMON_HOST=localhost \
#     SKIP_CLAUDE=1 scripts/e2e-claude.sh
#
# "Sandboxes" are just names; `exec` runs locally. Simulates proxy placeholder substitution:
# once `secret set-custom --sandbox N ... --placeholder P --value-stdin` (or `--value V`) ran, `exec N` sees PLACEHOLDER=V
# (FAKE_SBX_NO_SUBSTITUTION=1 simulates the proxy not substituting, FAKE_SBX_PLACEHOLDER_KEYED=1
# simulates all sandboxes sharing one secret because they share the placeholder). Reachability probes
# (`curl -w %{http_code} https://HOST`) are answered from the recorded policy (200 if allowed for that
# sandbox, else 403), so no real blocked requests - and no approval prompts on the host - are made.
# Keep SKIP_CLAUDE=1: the Claude step would modify the real ~/.claude.json of whoever runs it.
STATE="${FAKE_SBX_STATE:?}"
mkdir -p "$STATE"
touch "$STATE/sandboxes"
printf '%s\n' "$*" >> "$STATE/calls.log"     # every invocation, for order checks (test-launcher.sh)
cmd="$1"; shift
case "$cmd" in
  create|run)
    # `run` additionally prints the args it got (stands in for attaching to the agent).
    [ "$cmd" = run ] && echo "fake sbx run args: $*"
    # FAKE_SBX_CREATE_FAIL=1 makes `create` fail the way sbx does when it can't create a sandbox.
    if [ "$cmd" = create ] && [ -n "${FAKE_SBX_CREATE_FAIL:-}" ]; then echo "error: fake create failure"; exit 3; fi
    # `--kit DIR` is only checked for a kit descriptor (a root *.yaml); the kit itself (MCP registration, network
    # allow-list) is not emulated - the daemon is reached on localhost without a policy anyway.
    name=""; agent=""; ws=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift 2 ;;
        --kit) ls "$2"/*.yaml >/dev/null 2>&1 || { echo "error: no kit descriptor in $2"; exit 1; }; kits="${kits:-}$2
"; shift 2 ;;
        --kit-arg) shift 2 ;;
        -*) shift ;;
        *) if [ -z "$agent" ]; then agent="$1"; elif [ -z "$ws" ]; then ws="$1"; fi; shift ;;
      esac
    done
    # `run <existing name>` attaches; nothing to create.
    [ "$cmd" = run ] && grep -qx "$agent" "$STATE/sandboxes" && exit 0
    # Like sbx: without --name the sandbox is named <agent>-<workspace dir name>.
    [ -n "$name" ] || { [ "$cmd" = run ] && [ -z "$ws" ] && exit 0; name="$agent-$(basename "${ws:-$PWD}")"; }
    echo "$name" >> "$STATE/sandboxes"
    # What `ls` and `inspect` report about it: its workspace and its mixin kits.
    echo "${ws:-$PWD}" > "$STATE/ws-$name"; printf '%s' "${kits:-}" > "$STATE/kits-$name"
    echo "✓ Created sandbox $name" ;;
  kit)
    case "$1" in
      validate)
        ls "$2"/*.yaml >/dev/null 2>&1 || { echo "fake sbx: kit $1 $2 failed" >&2; exit 1; }
        echo "kit $2 looks valid (fake: only checks for a descriptor)" ;;
      add)
        # `kit add SANDBOX DIR [--kit-arg ...]`: FAKE_SBX_KIT_ADD_FAIL=1 refuses like sbx does for a
        # sandbox it cannot add a kit to. Adding a kit again replaces it (sbx 0.53).
        grep -qx "$2" "$STATE/sandboxes" || { echo "error: sandbox \"$2\" not found"; exit 1; }
        if [ -n "${FAKE_SBX_KIT_ADD_FAIL:-}" ]; then echo "error: sandbox \"$2\" was created before shell shipped as a kit; recreate it"; exit 1; fi
        { grep -vxF "$3" "$STATE/kits-$2" 2>/dev/null; echo "$3"; } > "$STATE/kits.new"; mv "$STATE/kits.new" "$STATE/kits-$2"
        echo "Added kit goversbx to sandbox $2" ;;
      *) echo "fake sbx: unsupported kit $1" >&2; exit 1 ;;
    esac ;;
  inspect)
    # `inspect NAME --format json`, the fields the launcher reads. FAKE_SBX_SESSIONS=n: attached
    # sessions; FAKE_SBX_INSPECT_FAIL=1: sbx cannot answer.
    name="$1"
    [ -z "${FAKE_SBX_INSPECT_FAIL:-}" ] && grep -qx "$name" "$STATE/sandboxes" || { echo "error: sandbox \"$name\" not found"; exit 1; }
    printf '{"name":"%s","agent":"claude","kits":["docker.io/sbx/claude@sha256:0"' "$name"
    while read -r k; do [ -z "$k" ] || printf ',"%s"' "$k"; done < "$STATE/kits-$name"
    ws="$(cat "$STATE/ws-$name")"
    printf '],"state":"stopped","created_version":"v0.53.0","sessions":%s,"workspace":"%s","host_mounts":[{"host_path":"%s"}' "${FAKE_SBX_SESSIONS:-0}" "$ws" "$ws"
    [ ! -f "$STATE/env-$name" ] || printf ',{"host_path":"%s/sbxenv.yaml","read_only":true}' "$ws"
    echo ']}' ;;
  cp) echo "copied $1 to $2" ;;
  ls)
    printf '['; first=1
    while read -r n; do [ $first = 1 ] || printf ','; first=0
      printf '{"name":"%s","id":"id-%s","agent":"claude","status":"running","workspaces":["%s"],"created_at":"2026-10-14T00:00:00Z"}' "$n" "$n" "$(cat "$STATE/ws-$n" 2>/dev/null)"
    done < "$STATE/sandboxes"; echo ']' ;;
  exec)
    envs=()
    while [ "$1" = -e ]; do envs+=("$2"); shift 2; done
    name="$1"; shift
    # FAKE_SBX_EXEC_NOOP=1: only record the call (the launcher tests must not run a sandbox's
    # commands on the machine).
    [ -z "${FAKE_SBX_EXEC_NOOP:-}" ] || exit 0
    # Emulate sbx network policy for the script's "is https://HOST reachable" probes, so the smoke
    # test never sends real blocked requests (which would raise approval prompts on the host).
    if [[ "$*" == *"%{http_code}"* && "$*" =~ https://([^[:space:]]+) ]]; then
      host="${BASH_REMATCH[1]}"
      if grep -q "^$host $name\$" "$STATE/policy" 2>/dev/null; then echo 200; else echo 403; fi
      exit 0
    fi
    # FAKE_SBX_PLACEHOLDER_KEYED=1 simulates secrets keyed by placeholder alone (last registration
    # wins for every sandbox) - the collision the e2e script's step 4b is there to detect.
    secret_file="$STATE/secret-$name"; [ -n "${FAKE_SBX_PLACEHOLDER_KEYED:-}" ] && secret_file="$STATE/secret-shared"
    sub=""; [ -z "${FAKE_SBX_NO_SUBSTITUTION:-}" ] && [ -f "$secret_file" ] && sub="PLACEHOLDER=$(cat "$secret_file")"
    env "${envs[@]}" $sub "$@" ;;
  rm) echo "removed" ;;
  stop) echo "stopped $*" ;;
  version) echo "sbx version v${FAKE_SBX_VERSION:-0.53.0} fake" ;;
  --help) echo "fake sbx help" ;;
  env)
    # `sbx env plan|create|run|rm` for the launcher tests: the environment is ./sbxenv.yaml merged
    # over ~/.sbxenv.yaml (only `agent:` and `name:` are read). A path argument is recorded like
    # everything else in calls.log - the launcher must never pass one.
    sub="$1"; shift
    name=""; force=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name="$2"; shift 2 ;;
        --force|-f) force=1; shift ;;
        --) break ;;
        *) shift ;;
      esac
    done
    field() { # $1 = key: the project file's value, else the user defaults'
      for f in sbxenv.yaml "$HOME/.sbxenv.yaml"; do
        v="$(sed -n "s/^$1: *[\"']\{0,1\}\([^\"' #]*\).*/\1/p" "$f" 2>/dev/null | head -n 1)"
        [ -n "$v" ] && { echo "$v"; return; }
      done
    }
    [ -f sbxenv.yaml ] || [ -f "$HOME/.sbxenv.yaml" ] || { echo "error: no sbxenv.yaml found at $PWD/sbxenv.yaml"; exit 1; }
    agent="$(field agent)"
    [ -n "$agent" ] || { echo "error: invalid $PWD/sbxenv.yaml: agent is required"; exit 1; }
    [ -n "$name" ] || name="$(sed -n 's/^name: *\([^ #]*\).*/\1/p' sbxenv.yaml 2>/dev/null | head -n 1)"
    [ -n "$name" ] || name="$agent-$(basename "$PWD")"
    case "$sub" in
      plan)
        if [ -n "${FAKE_SBX_PLAN_FAIL:-}" ]; then echo "error: fake plan failure"; exit 1; fi
        # FAKE_SBX_PLAN_NO_NAME=1: a later sbx whose plan output the launcher cannot read.
        printf '\nENVIRONMENT\n'
        [ -n "${FAKE_SBX_PLAN_NO_NAME:-}" ] || printf '  Name:   %s\n' "$name"
        printf '  Files:  %s\n\nSANDBOX\n  + %s\n      agent: %s\n' "$PWD/sbxenv.yaml" "$name" "$agent" ;;
      create)
        if [ -n "${FAKE_SBX_CREATE_FAIL:-}" ]; then echo "error: fake create failure"; exit 3; fi
        # FAKE_SBX_NEEDS_APPROVAL=1: like sbx without a terminal - refused unless --force.
        if [ -n "${FAKE_SBX_NEEDS_APPROVAL:-}" ] && [ -z "$force" ]; then
          echo "error: the merged environment changes things outside the sandbox that have not been approved; approve this invocation with --force (-f)"; exit 1
        fi
        echo "$name" >> "$STATE/sandboxes"
        # The kits of the merged environment: every `- source:` / plain entry of both files.
        echo "$PWD" > "$STATE/ws-$name"; : > "$STATE/env-$name"
        sed -n 's/^ *- *\(source: *\)\{0,1\}\([^ #]*kits\/[^ #]*\).*/\2/p' "$HOME/.sbxenv.yaml" sbxenv.yaml 2>/dev/null > "$STATE/kits-$name"
        echo "✓ Created sandbox $name" ;;
      run)
        grep -qx "$name" "$STATE/sandboxes" || { echo "$name" >> "$STATE/sandboxes"; echo "$PWD" > "$STATE/ws-$name"; : > "$STATE/kits-$name"; }
        echo "fake sbx env run: attached to $name, agent args: $*" ;;
      rm) grep -vx "$name" "$STATE/sandboxes" > "$STATE/sandboxes.new"; mv "$STATE/sandboxes.new" "$STATE/sandboxes"; echo "removed $name" ;;
      *) echo "fake sbx: unsupported env $sub" >&2; exit 1 ;;
    esac ;;
  policy)
    sub="$1"; shift
    case "$sub" in
      allow) echo "$2 $4" >> "$STATE/policy"; echo "allowed $2 for $4" ;;
      ls) grep " $1\$" "$STATE/policy" 2>/dev/null ;;
      log) echo "fake policy log" ;;
    esac ;;
  secret)
    sub="$1"; shift
    case "$sub" in
      set-custom)
        # Same flags as the real CLI (sbx docs + docker/sbx-releases#650); unknown flags are rejected
        # the way sbx does, so a wrong flag in the daemon shows up here too.
        while [ $# -gt 0 ]; do
          case "$1" in
            --value-stdin) v="$(cat)"; shift; continue ;;
            --no-input) shift; continue ;;
            --sandbox) n="$2";; --value) v="$2";; --placeholder) ;;
            --host) [[ "$2" == *:* || "$2" == */* ]] && { echo "error: invalid target \"$2\": expected host or IP without scheme/port"; exit 1; } ;;
            --env) [[ "$2" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "error: invalid env name \"$2\": expected pattern ^[A-Z_][A-Z0-9_]*\$"; exit 1; } ;;
            *) echo "error: unknown flag: $1"; echo "  try: sbx secret set-custom --help"; exit 1 ;;
          esac; shift 2
        done
        if [ -n "${FAKE_SBX_PLACEHOLDER_KEYED:-}" ]; then echo "$v" > "$STATE/secret-shared"; else echo "$v" > "$STATE/secret-$n"; fi
        echo "secret set for $n" ;;
      rm) echo "removed secret" ;;
      *) echo "fake sbx: unsupported secret $sub" >&2; exit 1 ;;
    esac ;;
  *) echo "fake sbx: unsupported $cmd" >&2; exit 1 ;;
esac
