#!/usr/bin/env bash
# Host-side launcher: makes sure the goversbx daemon is running, then starts a sandbox with the
# goversbx kit. A kit can't do this itself - kit hooks run inside the sandbox, the daemon needs the
# host's sbx CLI and must stay outside the sandbox's control.
#
#   goversbx run [--goversbx-kit claude|pi|omp|opencode] [sbx run args...]
#       Starts the daemon if it isn't running, then `sbx run --kit <kit> <args...>`.
#       Examples:  goversbx run claude ~/my-project
#                  goversbx run --name my-sb claude ~/my-project
#                  goversbx run --goversbx-kit pi --name pi-sb shell ~/my-project
#       --kit is only added for a NEW sandbox: if the sandbox named by --name (or by the first
#       positional argument) already exists, the args go to `sbx run` unchanged - add the kit to an
#       existing sandbox with `sbx kit add` instead.
#   goversbx start     start the daemon in the background (no-op if already running)
#   goversbx stop      stop a daemon started by this script
#   goversbx status    daemon state, ports, log location
#   goversbx logs      follow the daemon log
#   goversbx dashboard open the admin UI in your default browser
#   goversbx version   installed release version ("dev" in a repo checkout)
#
# The daemon keeps running after the sandbox session ends - it serves every sandbox; stop it with
# `goversbx stop` (or `brew services stop goversbx` if Homebrew started it). It runs for real
# (GOVERSBX_SBX_DRY_RUN=false) unless you set that yourself; every other GOVERSBX_* variable is
# passed through to it (see README).
#
# Two layouts: installed (Homebrew or the release tarball) runs the native `goversbx-daemon` binary
# next to this script, with kits in ../share/goversbx/kits; a repo checkout (scripts/goversbx) runs
# the JVM jar instead and (re)builds it with Gradle when it is missing or older than daemon/ sources.
#
# Knobs: SBX=sbx, GOVERSBX_KIT=claude (default kit), GOVERSBX_STATE_DIR=~/.local/state/goversbx
# (pid file + daemon.log), GOVERSBX_SANDBOX_API_PORT=8787, GOVERSBX_ADMIN_PORT=8788,
# GOVERSBX_DAEMON_BIN / GOVERSBX_KITS_DIR (override where the daemon binary and the kits are).
# Needs: sbx, curl; java (21+) only in a repo checkout. bash 3.2 compatible (macOS).

set -u

SBX="${SBX:-sbx}"
# Resolve symlinks by hand (macOS before 13 has no `realpath`, its `readlink` no `-f`).
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
JAR="$REPO_DIR/daemon/build/libs/goversbx-daemon.jar"
DAEMON_BIN="${GOVERSBX_DAEMON_BIN:-}"
[ -z "$DAEMON_BIN" ] && [ -x "$SCRIPT_DIR/goversbx-daemon" ] && DAEMON_BIN="$SCRIPT_DIR/goversbx-daemon"
if [ -n "${GOVERSBX_KITS_DIR:-}" ]; then
  KITS_DIR="$GOVERSBX_KITS_DIR"
elif [ -d "$SCRIPT_DIR/../share/goversbx/kits" ]; then
  KITS_DIR="$(cd "$SCRIPT_DIR/../share/goversbx/kits" && pwd)"
else
  KITS_DIR="$REPO_DIR/sandbox-kit/kits"
fi
STATE_DIR="${GOVERSBX_STATE_DIR:-$HOME/.local/state/goversbx}"
PID_FILE="$STATE_DIR/daemon.pid"
LOG_FILE="$STATE_DIR/daemon.log"
SANDBOX_API_PORT="${GOVERSBX_SANDBOX_API_PORT:-8787}"
ADMIN_PORT="${GOVERSBX_ADMIN_PORT:-8788}"
ADMIN="http://127.0.0.1:$ADMIN_PORT"

say() { printf 'goversbx: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }

daemon_pid() { # prints the pid of a daemon started by this script, if it is still alive
  local pid
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE")"
  kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
  rm -f "$PID_FILE"; return 1
}

healthy() {
  curl -s --max-time 2 "$ADMIN/api/health" 2>/dev/null | grep -q '"ok"' \
    && curl -s --max-time 2 "http://127.0.0.1:$SANDBOX_API_PORT/api/health" 2>/dev/null | grep -q '"ok"'
}

# Only curl's "couldn't connect" (7) means free: a process that accepts but never answers (e.g. a
# JVM daemon whose jar was rebuilt under it) times out (28) and still holds the port.
port_taken() { curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$1/"; [ $? -ne 7 ]; }

build_if_needed() {
  if [ -f "$JAR" ] && [ -z "$(find "$REPO_DIR/daemon/src" "$REPO_DIR/daemon/build.gradle.kts" -newer "$JAR" -print -quit)" ]; then
    return 0
  fi
  say "building the daemon jar ..."
  (cd "$REPO_DIR" && ./gradlew -q :daemon:shadowJar) >"$STATE_DIR/build.log" 2>&1 \
    || { cat "$STATE_DIR/build.log" >&2; die "daemon build failed (log: $STATE_DIR/build.log)"; }
}

start_daemon() {
  local pid
  mkdir -p "$STATE_DIR"
  if healthy; then
    pid="$(daemon_pid)" && say "daemon already running (pid $pid), admin UI $ADMIN" \
      || say "daemon already running (not started by this script), admin UI $ADMIN"
    # A daemon started before the last code change keeps running the old build.
    if [ -z "$DAEMON_BIN" ] && [ -f "$PID_FILE" ] && { [ "$JAR" -nt "$PID_FILE" ] \
         || [ -n "$(find "$REPO_DIR/daemon/src" "$REPO_DIR/daemon/build.gradle.kts" -newer "$PID_FILE" -print -quit)" ]; }; then
      say "WARNING: the running daemon is older than the daemon code - restart it: scripts/goversbx stop && scripts/goversbx start"
    fi
    return 0
  fi
  for port in "$SANDBOX_API_PORT" "$ADMIN_PORT"; do
    port_taken "$port" && die "port $port is in use by something that isn't a healthy goversbx daemon - find it with: lsof -nP -iTCP:$port -sTCP:LISTEN"
  done
  command -v "$SBX" >/dev/null 2>&1 || die "'$SBX' not found on PATH"
  if [ -n "$DAEMON_BIN" ]; then
    set -- "$DAEMON_BIN"
  else
    command -v java >/dev/null 2>&1 || die "java not found on PATH (JDK 21+ needed in a repo checkout)"
    build_if_needed
    # Run a copy: a JVM loads classes from its jar lazily, so rebuilding the jar under a running
    # daemon breaks it (NoClassDefFoundError on the next new code path, e.g. accepting a connection).
    cp "$JAR" "$STATE_DIR/goversbx-daemon.jar"
    set -- java -jar "$STATE_DIR/goversbx-daemon.jar"
  fi
  GOVERSBX_SBX_DRY_RUN="${GOVERSBX_SBX_DRY_RUN:-false}" \
  GOVERSBX_SBX_BINARY="${GOVERSBX_SBX_BINARY:-$SBX}" \
    nohup "$@" >>"$LOG_FILE" 2>&1 </dev/null &
  pid=$!
  echo "$pid" >"$PID_FILE"
  for _ in $(seq 1 30); do
    healthy && { say "daemon started (pid $pid), admin UI $ADMIN, log $LOG_FILE"; return 0; }
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  tail -20 "$LOG_FILE" >&2
  kill "$pid" 2>/dev/null; rm -f "$PID_FILE"
  die "daemon did not come up (log: $LOG_FILE)"
}

stop_daemon() {
  local pid
  if pid="$(daemon_pid)"; then
    kill "$pid"
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    rm -f "$PID_FILE"
    say "daemon stopped (pid $pid)"
  elif healthy; then
    die "a daemon is running on $ADMIN but wasn't started by this script - stop it where it was started (Homebrew: brew services stop goversbx)"
  else
    say "daemon not running"
  fi
}

open_dashboard() { # open the admin UI in the default browser, at the configured admin port
  if ! healthy; then
    die "daemon not running on $ADMIN - start it with 'goversbx start' (or 'goversbx run ...')"
  fi
  local opener="" o
  for o in open xdg-open; do command -v "$o" >/dev/null 2>&1 && { opener="$o"; break; }; done
  [ -n "$opener" ] || die "no browser opener found (open/xdg-open) - open $ADMIN yourself"
  say "opening $ADMIN"
  "$opener" "$ADMIN" >/dev/null 2>&1 &
}

sandbox_exists() { # $1 = name
  "$SBX" ls --format json 2>/dev/null | grep -q "\"name\": *\"$1\""
}

# Name of the sandbox `sbx run <args>` refers to: the value of --name, else the first positional arg.
target_sandbox() {
  local first=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) echo "${2:-}"; return ;;
      --name=*) echo "${1#--name=}"; return ;;
      -*) ;;
      *) [ -z "$first" ] && first="$1" ;;
    esac
    shift
  done
  echo "$first"
}

run_sandbox() {
  local kit="${GOVERSBX_KIT:-claude}" kit_dir target
  if [ "${1:-}" = --goversbx-kit ]; then kit="${2:?--goversbx-kit needs claude, pi, omp or opencode}"; shift 2; fi
  kit_dir="$KITS_DIR/goversbx-$kit"
  [ -f "$kit_dir/spec.yaml" ] || die "unknown kit '$kit' (no $kit_dir/spec.yaml)"
  [ $# -gt 0 ] || die "usage: goversbx run [--goversbx-kit claude|pi|omp|opencode] [sbx run args...]  e.g. run claude ~/my-project"

  start_daemon || exit 1

  target="$(target_sandbox "$@")"
  if [ -n "$target" ] && sandbox_exists "$target"; then
    say "sandbox $target already exists - starting it without --kit (use 'sbx kit add' to add the kit)"
    exec "$SBX" run "$@"
  fi
  if [ "$SANDBOX_API_PORT" = 8787 ]; then
    exec "$SBX" run --kit "$kit_dir" "$@"
  fi
  exec "$SBX" run --kit "$kit_dir" --kit-arg "goversbx-$kit.daemonPort=$SANDBOX_API_PORT" "$@"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  run) run_sandbox "$@" ;;
  start) start_daemon ;;
  stop) stop_daemon ;;
  status)
    if healthy; then
      pid="$(daemon_pid)" || pid="unknown (not started by this script)"
      echo "running, pid $pid"
    else
      echo "not running"
    fi
    echo "admin UI: $ADMIN   sandbox port: $SANDBOX_API_PORT   log: $LOG_FILE" ;;
  logs) exec tail -f "$LOG_FILE" ;;
  dashboard) open_dashboard ;;
  version|--version)
    if [ -f "$SCRIPT_DIR/../share/goversbx/VERSION" ]; then cat "$SCRIPT_DIR/../share/goversbx/VERSION"
    else echo "dev ($REPO_DIR)"; fi ;;
  *) sed -n '2,33p' "$SELF" | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || [ "$cmd" = help ] || [ "$cmd" = -h ] || exit 1 ;;
esac
